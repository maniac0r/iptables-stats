# Ukážkový výstup `nft list ruleset`
table inet filter {
	set blocklist {
		type ipv4_addr
		flags interval
		elements = { 198.51.100.0/24, 203.0.113.99 }
	}

	chain input {
		type filter hook input priority filter; policy drop;
		iif "lo" counter packets 700 bytes 50000 accept
		ct state established,related counter packets 600 bytes 45000 accept
		ct state invalid counter packets 10 bytes 600 drop
		ip saddr @blocklist counter packets 50 bytes 3000 jump blocklist
		tcp dport 22 counter packets 20 bytes 1200 jump ssh_in
		meta l4proto icmp counter packets 5 bytes 420 jump icmp_in
		tcp dport { 80, 443 } counter packets 30 bytes 2000 accept comment "web"
		tcp dport 25 counter packets 3 bytes 180 reject with tcp reset
		udp dport 161 counter packets 2 bytes 120 reject with icmp type port-unreachable
		iifname vmap { "eth1" : jump lan_in, "eth2" : jump dmz_in }
		counter packets 15 bytes 900 jump logdrop
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		counter packets 400 bytes 38000 jump docker_user
		ct state established,related oifname "docker0" counter packets 300 bytes 30000 accept
		oifname "docker0" counter packets 40 bytes 2400 jump docker
		iifname "docker0" oifname != "docker0" counter packets 0 bytes 0 accept
	}

	chain output {
		type filter hook output priority filter; policy accept;
	}

	chain docker_user {
		counter packets 400 bytes 38000 return
	}
	chain docker {
		iifname != "docker0" oifname "docker0" ip daddr 172.17.0.2 tcp dport 80 counter packets 40 bytes 2400 accept
	}
	chain ssh_in {
		ip saddr 192.168.1.0/24 counter packets 5 bytes 300 accept
		ip saddr 10.0.0.0/24 counter packets 3 bytes 180 accept comment "VPN; len interne"
		update @ssh_rate { ip saddr limit rate over 4/minute } counter packets 2 bytes 120 jump blocklist
		counter packets 10 bytes 600 goto logdrop
	}
	chain icmp_in {
		icmp type echo-request limit rate 5/second counter packets 5 bytes 420 accept
		counter packets 0 bytes 0 drop
	}
	chain blocklist {
		ip saddr 198.51.100.0/24 counter packets 50 bytes 3000 drop
		ip saddr 203.0.113.99 counter packets 0 bytes 0 jump logdrop
	}
	chain lan_in {
		tcp dport { 22, 445 } counter packets 3 bytes 200 accept
	}
	chain dmz_in {
		counter packets 0 bytes 0 drop
	}
	chain logdrop {
		limit rate 5/minute counter packets 0 bytes 0 log prefix "FW-DROP: " level warn
		counter packets 0 bytes 0 drop
	}
	chain old_unused {
		counter packets 0 bytes 0 accept
	}
}
table ip nat {
	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		fib daddr type local counter packets 20 bytes 1200 jump docker_nat
		iifname "eth0" counter packets 10 bytes 800 jump portfwd
	}
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		ip saddr 172.17.0.0/16 oifname != "docker0" counter packets 9 bytes 600 masquerade
		ip saddr 10.0.0.0/24 oifname "eth0" counter packets 3 bytes 200 snat to 203.0.113.10
	}
	chain docker_nat {
		iifname "docker0" counter packets 0 bytes 0 return
		iifname != "docker0" tcp dport 8080 counter packets 4 bytes 240 dnat to 172.17.0.2:80
	}
	chain portfwd {
		tcp dport 2222 counter packets 6 bytes 360 dnat to 10.0.0.5:22 comment "ssh na bastion"
		tcp dport 3306 counter packets 0 bytes 0 redirect to :13306
	}
}
table ip mangle {
	chain prerouting {
		type filter hook prerouting priority mangle; policy accept;
		iifname "eth0" counter packets 40 bytes 3200 jump mark_wan
	}
	chain mark_wan {
		tcp dport { 80, 443 } counter packets 40 bytes 3200 meta mark set 0x00000010
		udp dport 53 counter packets 0 bytes 0 ct mark set 0x00000020
		ip dscp cs3 counter packets 1 bytes 64 ip dscp set cs5
	}
}
